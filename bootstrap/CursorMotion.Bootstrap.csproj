<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>CursorMotion</AssemblyName>
    <Version>3.10.0</Version>
    <FileVersion>3.10.0.0</FileVersion>
    <ApplicationIcon>../src/Assets/AppIcon.ico</ApplicationIcon>
    <ApplicationManifest>../src/app.manifest</ApplicationManifest>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <DebugType>embedded</DebugType>
    <PublishTrimmed>true</PublishTrimmed>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="../src/Assets/AppIcon.png" LogicalName="CursorMotion.Preparation.Icon.png" />
    <EmbeddedResource Include="$(PayloadDirectory)/payload.zip" LogicalName="CursorMotion.Payload.zip" />
    <EmbeddedResource Include="$(PayloadDirectory)/payload.json" LogicalName="CursorMotion.Payload.json" />
  </ItemGroup>
</Project>
